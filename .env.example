# ============================================================
# LinkUp Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env files with real credentials to version control.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:8081

# --- Database ---
# NOTE: The credentials below are environment-backed.
# Hibernate reads the DB password from the environment variable DB_PASSWORD.
# Example: set DB_PASSWORD=xxxxx in your shell or in a .env file.
DB_URL=jdbc:mysql://localhost:3306/link_up?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=DbSecur3P@ss!2026

# --- Ngrok (temporary public tunnel) ---
# NOTE: Use an environment variable in production, not a hardcoded URL.
# Example: export NGROK_URL=https://your-ngrok-subdomain.ngrok-free.app
NGROK_URL=https://217b7332d13d.ngrok-free.app

# ============================================================
# END OF FILE
# ============================================================
